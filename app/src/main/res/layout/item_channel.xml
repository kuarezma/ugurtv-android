<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_channel_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Channel Index / Number -->
    <TextView
        android:id="@+id/tvChannelNum"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textColor="@color/tv_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="1" />

    <!-- Channel Logo -->
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_channel_placeholder" />

    <!-- Channel Name -->
    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="TRT 1 HD" />

    <!-- Favorite star indicator -->
    <ImageView
        android:id="@+id/ivFavIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_heart_filled"
        android:visibility="gone" />

    <!-- Live indicator -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_live"
        android:text="@string/live_badge"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>

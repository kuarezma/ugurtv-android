<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_main"
    android:orientation="horizontal">

    <!-- ============================================================== -->
    <!-- 1. LEFT NAVIGATION RAIL (Vertical TV Remote Sidebar - 88dp)     -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/navRail"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nav_rail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- TV Brand Logo -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_tv_brand_logo" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#1E2B47" />

        <!-- Navigation Buttons (Focusable with D-Pad) -->
        <LinearLayout
            android:id="@+id/btnNavLiveTv"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_rail_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnNavLiveTv"
            android:nextFocusUp="@+id/btnNavLiveTv"
            android:nextFocusDown="@+id/btnNavMovies"
            android:nextFocusRight="@+id/rvCategories"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/tab_live_tv"
                android:src="@drawable/ic_live_tv" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Canlı"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavMovies"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_rail_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnNavMovies"
            android:nextFocusUp="@+id/btnNavLiveTv"
            android:nextFocusDown="@+id/btnNavSeries"
            android:nextFocusRight="@+id/rvMovies"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/tab_movies"
                android:src="@drawable/ic_movie" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Film"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavSeries"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_rail_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnNavSeries"
            android:nextFocusUp="@+id/btnNavMovies"
            android:nextFocusDown="@+id/btnNavFavorites"
            android:nextFocusRight="@+id/rvSeries"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/tab_series"
                android:src="@drawable/ic_tv_series" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dizi"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavFavorites"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_rail_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnNavFavorites"
            android:nextFocusUp="@+id/btnNavSeries"
            android:nextFocusDown="@+id/btnNavSearch"
            android:nextFocusRight="@+id/rvChannels"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/tab_favorites"
                android:src="@drawable/ic_heart_filled" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Favori"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavSearch"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_rail_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnNavSearch"
            android:nextFocusUp="@+id/btnNavFavorites"
            android:nextFocusDown="@+id/btnNavSettings"
            android:nextFocusRight="@+id/rvCategories"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Arama"
                android:src="@drawable/ic_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ara"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Flexible Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Settings Button at Bottom -->
        <LinearLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_nav_rail_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnNavSettings"
            android:nextFocusUp="@+id/btnNavSearch"
            android:nextFocusDown="@+id/btnNavSettings"
            android:nextFocusRight="@+id/rvCategories"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/tab_settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ayar"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ============================================================== -->
    <!-- 2. MAIN CONTENT AREA (Takes full remaining space)              -->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- ========================================================== -->
        <!-- SECTION A: CANLI TV (TiViMate Ultra Ergonomic Layout)       -->
        <!-- ========================================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sectionLiveTv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Column 1: Categories (Width 250dp) -->
            <LinearLayout
                android:id="@+id/leftCategoriesPane"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:background="@color/tv_bg_pane"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KATEGORİLER"
                    android:textColor="@color/tv_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:nextFocusLeft="@+id/btnNavLiveTv"
                    android:nextFocusRight="@+id/rvChannels"
                    tools:listitem="@layout/item_category" />
            </LinearLayout>

            <!-- Column 2: Channels List (Width 360dp) -->
            <LinearLayout
                android:id="@+id/centerChannelsPane"
                android:layout_width="360dp"
                android:layout_height="match_parent"
                android:background="@color/tv_bg_main"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/leftCategoriesPane"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Header with Title & Count -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cat_all"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChannelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tv_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="142 Kanal" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:nextFocusLeft="@+id/rvCategories"
                    android:nextFocusRight="@+id/btnExpandFullscreen"
                    tools:listitem="@layout/item_channel" />

                <TextView
                    android:id="@+id/tvEmptyChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="@string/no_channels_found"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Column 3: Live Preview Player & Info (Remaining Width) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rightPreviewPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/tv_bg_pane"
                android:padding="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/centerChannelsPane"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Video Player Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/playerCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="14dp"
                    app:layout_constraintDimensionRatio="16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/previewPlayerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:resize_mode="fit"
                        app:use_controller="false" />

                    <ProgressBar
                        android:id="@+id/pbPreviewLoading"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/tv_accent"
                        android:visibility="gone" />

                    <FrameLayout
                        android:id="@+id/btnExpandFullscreen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_movie_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/rvChannels"
                        android:nextFocusDown="@+id/ivPreviewFavorite">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="16dp"
                            android:background="@drawable/bg_badge_live"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp"
                            android:text="@string/press_ok_fullscreen"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Channel Details Under Preview -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/playerCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivPreviewLogo"
                            android:layout_width="72dp"
                            android:layout_height="48dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_channel_placeholder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPreviewTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="24sp"
                                tools:text="TRT 1 HD" />

                            <TextView
                                android:id="@+id/tvPreviewCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="15sp"
                                tools:text="Ulusal Kanallar" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivPreviewFavorite"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_nav_rail_item"
                            android:contentDescription="@string/cat_favorites"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/rvChannels"
                            android:nextFocusUp="@+id/btnExpandFullscreen"
                            android:src="@drawable/ic_heart" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/remote_shortcuts_title"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/remote_shortcuts_desc"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========================================================== -->
        <!-- SECTION B: FİLMLER (Netflix Tarzı 65" TV Sinema Görünümü)   -->
        <!-- ========================================================== -->
        <LinearLayout
            android:id="@+id/sectionMovies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <!-- Hero Movie Billboard -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#0D1424"
                app:cardCornerRadius="18dp"
                app:cardElevation="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivHeroMovieBackdrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tv_banner_bg" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_osd_panel" />

                    <LinearLayout
                        android:layout_width="600dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_live"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="@string/featured_movie"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroMovieTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Interstellar"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/tvHeroMovieDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Bir grup kaşif, insanlığın geleceği için uzayın derinliklerine yolculuk yapar."
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnHeroPlayMovie"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_btn_netflix_play"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:nextFocusDown="@+id/rvMovies"
                                android:paddingStart="24dp"
                                android:paddingEnd="24dp"
                                android:text="@string/play_now"
                                android:textColor="#000000"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TÜM FİLMLER"
                android:textColor="@color/tv_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMovies"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnNavMovies"
                android:nextFocusUp="@+id/btnHeroPlayMovie"
                tools:listitem="@layout/item_movie_card" />
        </LinearLayout>

        <!-- ========================================================== -->
        <!-- SECTION C: DİZİLER (Netflix Tarzı Dizi Görünümü)            -->
        <!-- ========================================================== -->
        <LinearLayout
            android:id="@+id/sectionSeries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#0D1424"
                app:cardCornerRadius="18dp"
                app:cardElevation="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivHeroSeriesBackdrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tv_banner_bg" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_osd_panel" />

                    <LinearLayout
                        android:layout_width="600dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_live"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="@string/featured_series"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroSeriesTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Breaking Bad"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/tvHeroSeriesDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Kimya öğretmeni Walter White'ın gerilim dolu macerası."
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnHeroPlaySeries"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_netflix_play"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:nextFocusDown="@+id/rvSeries"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="@string/play_now"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TÜM DİZİLER"
                android:textColor="@color/tv_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSeries"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnNavSeries"
                android:nextFocusUp="@+id/btnHeroPlaySeries"
                tools:listitem="@layout/item_series_card" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 1. Fullscreen PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/fullscreenPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- 2. Loading / Buffering Indicator -->
    <ProgressBar
        android:id="@+id/pbBuffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/tv_accent"
        android:visibility="gone" />

    <!-- 3. Top-Right Numeric Dialing Badge (e.g. "12") -->
    <TextView
        android:id="@+id/tvDirectNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="36dp"
        android:background="@drawable/bg_channel_item"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/tv_accent"
        android:textSize="36sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="14" />

    <!-- 4. Left Quick Channel Drawer (OSD) -->
    <LinearLayout
        android:id="@+id/layoutQuickDrawer"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#E60A0E17"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hızlı Kanal Listesi"
            android:textColor="@color/tv_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuickChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            tools:listitem="@layout/item_channel_quick" />
    </LinearLayout>

    <!-- 5. Bottom OSD Info Bar (Shows on zap or OK press) -->
    <LinearLayout
        android:id="@+id/layoutBottomOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_panel"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="36dp"
        android:paddingEnd="40dp"
        android:paddingBottom="36dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Channel Number -->
            <TextView
                android:id="@+id/tvOsdChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_accent"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="001" />

            <!-- Channel Logo -->
            <ImageView
                android:id="@+id/ivOsdLogo"
                android:layout_width="72dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_channel_placeholder" />

            <!-- Channel Title & Category -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOsdTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="TRT 1 HD" />

                <TextView
                    android:id="@+id/tvOsdCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp"
                    tools:text="Ulusal Kanallar" />
            </LinearLayout>

            <!-- Badges & Action Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_live"
                android:text="@string/live_badge"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Favorite button -->
            <ImageView
                android:id="@+id/ivOsdFavorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:src="@drawable/ic_heart" />

            <!-- Aspect ratio toggle button -->
            <ImageView
                android:id="@+id/btnAspectRatio"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:src="@drawable/ic_aspect_ratio" />

            <!-- Current Clock -->
            <TextView
                android:id="@+id/tvOsdClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="20:15" />
        </LinearLayout>

        <!-- Remote Shortcut hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/channel_zap_hint"
            android:textColor="@color/tv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
